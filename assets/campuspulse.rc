// Native Windows Explorer, taskbar and Alt+Tab icon.
#include <windows.h>
IDI_ICON1 ICON "campuspulse.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,1,0
 PRODUCTVERSION 0,1,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "FileDescription", "CampusPulse - university notices and calendar\0"
            VALUE "FileVersion", "0.1.1\0"
            VALUE "InternalName", "CampusPulse\0"
            VALUE "OriginalFilename", "CampusPulse.exe\0"
            VALUE "ProductName", "CampusPulse\0"
            VALUE "ProductVersion", "0.1.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
