{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusPulse school configuration draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "school", "status", "reviewed_at", "categories", "fetch_defaults", "sources"],
  "allOf": [{"if": {"properties": {"reviewed_at": {"const": ""}}},
             "then": {"properties": {"status": {"const": "draft"}}}}],
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "onboarding_version": {"type":"integer","minimum":1},
    "school": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "aliases", "country", "province", "city", "timezone", "official_homepage"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "province": {"type": "string"},
        "city": {"type": "string"},
        "timezone": {"type": "string", "minLength": 1},
        "official_homepage": {"$ref": "#/$defs/httpUrl"},
        "identity_provenance": {"const": "automatic_homepage"},
        "status": {"const": "draft"}
      }
    },
    "status": {"enum": ["draft", "verified", "degraded", "disabled"]},
    "reviewed_at": {"anyOf": [{"type": "string", "format": "date"}, {"const": ""}]},
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/category"}},
    "fetch_defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["interval_minutes", "jitter_seconds", "per_host_concurrency", "min_request_interval_seconds", "respect_source_policy", "conditional_requests"],
      "properties": {
        "interval_minutes": {"type": "integer", "minimum": 1},
        "jitter_seconds": {"type": "integer", "minimum": 0},
        "per_host_concurrency": {"type": "integer", "minimum": 1},
        "min_request_interval_seconds": {"type": "number", "minimum": 0},
        "respect_source_policy": {"const": true},
        "conditional_requests": {"type": "boolean"}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "resource_discovery": {"type":"object", "additionalProperties":false,
      "required":["department_urls"], "properties":{
        "department_urls":{"type":"array","maxItems":12,"uniqueItems":true,"items":{"type":"string","format":"uri","pattern":"^https://[^/@:#?]+(?:[/?#]|$)"}},
        "max_pages":{"type":"integer","minimum":1,"maximum":32}}},
    "auto_discovery": {"type":"object", "additionalProperties":false,
      "required":["department_urls","max_pages"], "properties":{
        "department_urls":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/httpUrl"}},
        "max_pages":{"type":"integer","minimum":1,"maximum":24}}}
  },
  "anyOf":[{"required":["auto_discovery"]},{"properties":{"sources":{"minItems":1}}}],
  "$defs": {
    "key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "category": {"enum": ["exam", "competition", "scholarship", "campus_activity", "academic_affairs", "career"]},
    "httpUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "access": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["public", "login_required"]},
        "login_url": {"type": "string", "format": "uri", "pattern": "^https://[^/@:#?]+(?:[/?#]|$)"}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "login_required"}}, "required": ["mode"]},
        "then": {"required": ["login_url"]}
      }]
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "name", "discovery_url", "entry_url", "allowed_hosts", "adapter", "enabled", "validation_state", "category_hints", "extraction", "pending"],
      "properties": {
        "key": {"$ref": "#/$defs/key"},
        "name": {"type": "string", "minLength": 1},
        "discovery_url": {"$ref": "#/$defs/httpUrl"},
        "entry_url": {"anyOf": [{"$ref": "#/$defs/httpUrl"}, {"type": "null"}]},
        "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"}},
        "adapter": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "access": {"$ref": "#/$defs/access"},
        "enabled": {"type": "boolean"},
        "validation_state": {"enum": ["discovered", "list_readable", "detail_discovered", "adapter_verified"]},
        "category_hints": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/category"}},
        "extraction": {"type": ["object", "null"]},
        "pending": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [{
        "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
        "then": {"properties": {
          "entry_url": {"$ref": "#/$defs/httpUrl"},
          "adapter": {"not": {"const": "pending"}},
          "extraction": {"type": "object", "minProperties": 1},
          "validation_state": {"const": "adapter_verified"}
        }}
      }]
    }
  }
}
